# Frontend environment overrides (all optional).

# Base URL of the backend API. Leave as "/api/v1" when using the Vite dev
# proxy or the bundled nginx reverse proxy (docker-compose).
VITE_API_BASE_URL=/api/v1

# In dev, Vite proxies every /api request to the backend, so the browser only
# talks to the Vite server and the backend never sees CORS. Development backend
# for this project runs on http://127.0.0.1:8011 (that is also the default).
VITE_DEV_PROXY_TARGET=http://127.0.0.1:8011