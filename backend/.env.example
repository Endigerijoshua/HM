# Copy to `.env` to override defaults. All values are optional.
# Backend: TCIVIC_<SETTING> (see app/config.py)

# SQLite connection string (demo default). PostGIS-friendly later.
TCIVIC_DATABASE_URL=sqlite:///./temporal_civic.db

# Seed deterministic demo data on startup.
TCIVIC_SEED_ON_STARTUP=true

# Comma-separated list of allowed browser origins.
TCIVIC_CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# Logging verbosity: DEBUG | INFO | WARNING | ERROR
TCIVIC_LOG_LEVEL=INFO

# Geometry engine. Only "shapely" (the SQLite + in-Python store) is wired up in P0.
TCIVIC_GEOMETRY_ENGINE=shapely

# Demo-only admin token for admin endpoints (used from P1 onward). Leave empty to disable.
TCIVIC_ADMIN_TOKEN=